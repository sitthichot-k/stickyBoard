# ─────────────────────────────────────────────────────────────
# Variables consumed by docker-compose.yml (auto-loaded from .env)
# ─────────────────────────────────────────────────────────────

# Database
MONGO_DB=myapp
MONGO_PORT=27018          # host port → container 27017

# Backend
BACKEND_PORT=8081         # host port → container 8081 (internal port is fixed)

# Frontend
FRONTEND_PORT=8080        # host port → nginx (container 80)

# CORS: origin allowed to call the API — normally the frontend's public URL.
# Keep this in sync with FRONTEND_PORT.
FRONTEND_ORIGIN=http://localhost:8080

# ── AI helmet-detection (phase 1) ──
# Shared secret between the backend and the ai-detector service (leave empty to
# keep the AI endpoints closed and the detector stopped). Set a strong value.
AI_SERVICE_TOKEN=
VIOLATION_RETENTION_DAYS=30
# ai-detector only: helmet model + tuning. Put weights at ./ai-detector/models.
MODEL_PATH=/models/helmet.pt
NOHELMET_CLASSES=no-helmet,no_helmet,without helmet,nohelmet
CONF_THRESHOLD=0.5
SAMPLE_FPS=3
# Rider association — only flag bare heads on a motorcycle (skip pedestrians).
# Needs a motorcycle source: a primary model with a motorcycle class, or set
# MOTO_MODEL_PATH (e.g. yolov8n.pt). Set REQUIRE_MOTORCYCLE=false to disable.
REQUIRE_MOTORCYCLE=true
MOTO_MODEL_PATH=
