# Root-level ignores (each module has its own .gitignore too)

# Secrets / environment (keep the *.example templates committed)
.env
.env.*
!.env.example
!.env.prod.example

# Dependencies & build output (defensive — modules ignore their own too)
node_modules/
dist/
build/

# Logs
*.log
npm-debug.log*

# Local tooling / agent config
.claude/

# AI detector — model weights (large, mounted at runtime) + python caches.
# Keep the folder (+ its README) but never commit the weights themselves.
ai-detector/models/*
!ai-detector/models/README.md
yolov8n.pt
__pycache__/
*.pyc

# OS / editor
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
