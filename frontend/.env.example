# ── Build-time vars (read by vite.config.js, NOT shipped to the browser) ──
# Dev server / preview port.
PORT=8080

# ── Runtime vars (must be prefixed VITE_ to be exposed to browser code) ──
# Base URL of the backend API.
# Dev:    http://localhost:8081/api
# Docker: handled by nginx proxy, use /api
VITE_API_URL=http://localhost:8081/api
