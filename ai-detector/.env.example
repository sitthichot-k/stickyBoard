# AI detector configuration (phase 1 — helmet only).
#
# NOTE: Docker reads the project ROOT .env (compose), NOT this file. This file is
# only loaded when you run detector.py standalone (python-dotenv). Copy to
# `.env` here for standalone runs; otherwise set these in the root .env.

# Backend API base + the shared secret it expects (must match the backend's
# AI_SERVICE_TOKEN). Inside Docker the backend is reachable as `backend`.
API_URL=http://backend:8081/api/v1
AI_SERVICE_TOKEN=

# Path to the helmet YOLO weights (mount a volume here). Phase 1 uses a
# pre-trained model; the class name(s) meaning "no helmet" are matched below.
MODEL_PATH=/models/helmet.pt
NOHELMET_CLASSES=no-helmet,no_helmet,without helmet,nohelmet

# Detection tuning.
CONF_THRESHOLD=0.5         # min confidence to report
SAMPLE_FPS=3               # frames/sec to run inference on (lower = lighter)
SOURCES_REFRESH_SEC=30     # how often to re-sync the enabled-camera list
LOCAL_DEDUP_SEC=30         # don't re-report the same tracked rider within this window

# Rider association — only flag a bare head that belongs to a motorcycle rider
# (so pedestrians aren't reported). Motorcycles come from the primary model if it
# has a motorcycle class, else from MOTO_MODEL_PATH (e.g. "yolov8n.pt", COCO).
# Set REQUIRE_MOTORCYCLE=false to flag any bare head (no association).
REQUIRE_MOTORCYCLE=true
MOTO_MODEL_PATH=
MOTO_CLASSES=motorcycle,motorbike
# Overlay groups: vehicles drawn green, worn helmets drawn yellow (violations red).
VEHICLE_CLASSES=motorcycle,motorbike,car,truck,bus,bicycle
HELMET_CLASSES=with helmet,wearing helmet,helmet
ASSOC_MARGIN_X=0.2         # horizontal slack as a fraction of the motorcycle width
ASSOC_RISE=1.5            # how far above the bike (× its height) a rider head may sit

# Debug viewer — live annotated MJPEG so you can SEE the boxes + the violation
# decision (and the per-frame heads/motos/reported log). Open http://localhost:8090
DEBUG_VIEW=false
DEBUG_PORT=8090
