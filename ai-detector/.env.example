# AI detector configuration (phase 1 — helmet only).

# Backend API base + the shared secret it expects (must match the backend's
# AI_SERVICE_TOKEN). Inside Docker the backend is reachable as `backend`.
API_URL=http://backend:8081/api/v1
AI_SERVICE_TOKEN=

# Path to the helmet YOLO weights (mount a volume here). Phase 1 uses a
# pre-trained model; the class name(s) meaning "no helmet" are matched below.
MODEL_PATH=/models/helmet.pt
NOHELMET_CLASSES=no-helmet,no_helmet,without helmet,nohelmet

# Detection tuning.
CONF_THRESHOLD=0.5         # min confidence to report
SAMPLE_FPS=3               # frames/sec to run inference on (lower = lighter)
SOURCES_REFRESH_SEC=30     # how often to re-sync the enabled-camera list
LOCAL_DEDUP_SEC=30         # don't re-report the same tracked rider within this window
