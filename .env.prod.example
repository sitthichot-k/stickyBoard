# ─────────────────────────────────────────────────────────────
# PRODUCTION env — copy to `.env.prod` ON THE SERVER and fill in real values.
# NEVER commit the filled-in .env.prod (it holds secrets). Only this .example
# file is committed.
#
# Used by:  docker compose -f docker-compose.prod.yml --env-file .env.prod ...
# ─────────────────────────────────────────────────────────────

# Database name (mongo runs inside the stack; no host/port needed).
MONGO_DB=stickyBoard

# Internal backend port (kept private; not published to the internet).
BACKEND_PORT=8081

# Public URL of the site. With the default "80:80" mapping this is just the
# server's public IP (no port). Change to http://<IP>:8080 if you remap to 8080,
# or to https://your-domain.com once you add a domain + HTTPS.
FRONTEND_ORIGIN=http://REPLACE_WITH_EC2_PUBLIC_IP

# JWT signing secret — MUST be long & random. Generate on the server with:
#   openssl rand -hex 32
JWT_SECRET=REPLACE_WITH_openssl_rand_hex_32
JWT_EXPIRES_IN=7d

# Key that encrypts stored SMTP credentials at rest. Generate the same way:
#   openssl rand -hex 32
MAIL_SECRET=REPLACE_WITH_openssl_rand_hex_32

# First admin account, created by `npm run seed`. Use a strong password.
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=REPLACE_WITH_A_STRONG_PASSWORD

# Keep Swagger docs closed in production (set true only if you want /api/docs).
SWAGGER_ENABLED=false

# Logging / rate-limiting (safe defaults).
LOG_API_TRAFFIC=true
LOG_RETENTION_DAYS=30
RATE_LIMIT=true
