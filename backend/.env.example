# Server
NODE_ENV=development
PORT=8081

# CORS — origin allowed to call this API (the frontend dev/prod URL)
CORS_ORIGIN=http://localhost:8080

# MongoDB connection string
# Local:  mongodb://localhost:27017/myapp
# Docker: mongodb://mongo:27017/myapp
# Atlas:  mongodb+srv://<user>:<pass>@<cluster>.mongodb.net/myapp
MONGODB_URI=mongodb://localhost:27017/myapp

# Auth — JWT signing secret (set a strong random value in production)
JWT_SECRET=dev-secret-change-me
JWT_EXPIRES_IN=7d

# Seed admin (used by `npm run seed`)
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=admin1234

# Public frontend URL — used to build links in emails
APP_URL=http://localhost:8080

# Email (SMTP). Leave SMTP_HOST empty to log emails to the console (dev/template).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Sticky Board <no-reply@stickyboard.local>
# Key to encrypt the SMTP password at rest (falls back to JWT_SECRET). Set a strong value in prod.
MAIL_SECRET=

# Auth flow (also tunable live from the admin Config page)
ALLOW_REGISTRATION=false
REQUIRE_EMAIL_VERIFIED=false

# Logging — persist every API request as a DB log, and keep logs N days
LOG_API_TRAFFIC=true
LOG_RETENTION_DAYS=30

# Rate limiting — set RATE_LIMIT=false to disable entirely.
# Global flood guard: > RATE_LIMIT_MAX requests per window → blocked for BLOCK_MS.
RATE_LIMIT=true
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=150
RATE_LIMIT_BLOCK_MS=300000
# Strict login guard (brute-force).
LOGIN_RATE_WINDOW_MS=60000
LOGIN_RATE_MAX=8
LOGIN_RATE_BLOCK_MS=900000
