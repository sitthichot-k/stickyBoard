{
  "name": "backend",
  "version": "1.0.0",
  "description": "Backend API server (Node + Express + MongoDB)",
  "type": "module",
  "main": "src/routes/server.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node src/routes/server.js",
